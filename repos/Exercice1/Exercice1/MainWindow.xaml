<Window x:Class="Exercice1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Exercice1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="50">
        
        <TextBlock Text="Entrez votre nom :"
                   FontSize="16"
                   Margin="0,0,0,10"/>

        <TextBox Text="{Binding NomComplet, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="20"
                 Padding="5"
                 Margin="0,0,0,30"/>

        <TextBlock Text="Bonjour"
                   FontSize="24"
                   Foreground="Gray"/>

        <TextBlock Text="{Binding NomComplet}"
                   FontSize="36"
                   FontWeight="Bold"
                   Foreground="Blue"/>

    </StackPanel>
</Window>
