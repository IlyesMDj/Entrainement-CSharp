<Window x:Class="MenuiserieApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:MenuiserieApp.UI.ViewModels"
        xmlns:views="clr-namespace:MenuiserieApp.UI.Views"
        mc:Ignorable="d"
        Title="Gestion Atelier Menuiserie PVC" 
        Height="951" Width="1544"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:ClientViewModel}">
            <views:ClientView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:CommandeViewModel}">
            <views:CommandeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:HistoriqueCommandeViewModel}">
            <views:HistoriqueCommandeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TableauBordViewModel}">
            <views:TableauBordView />
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E293B" Padding="20">
            <StackPanel>
                <TextBlock Text="Menuiserie PVC" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Menu Atelier v1.0" Foreground="#64748B" FontSize="12" Margin="0,0,0,40"/>

                <Button Content="📊  Tableau de Bord" 
                    Command="{Binding AfficherTableauBordCommand}"
                    Background="Transparent" Foreground="White" BorderThickness="0" Height="45" FontSize="14" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,8,0,0" Cursor="Hand"/>

                <Button Content="👥  Gestion Clients" 
                        Command="{Binding AfficherEcranClientsCommand}"
                        Background="Transparent" Foreground="White" BorderThickness="0" Height="45" FontSize="14" HorizontalContentAlignment="Left" Padding="12,0" Cursor="Hand"/>

                <Button Content="📦  Nouvelle Commande" 
                        Command="{Binding AfficherEcranCommandeCommand}"
                        Background="Transparent" Foreground="White" BorderThickness="0" Height="45" FontSize="14" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,8,0,0" Cursor="Hand"/>

                <Button Content="📋  Historique Commandes" 
                Command="{Binding AfficherEcranHistoriqueCommand}"
                Background="Transparent" Foreground="White" BorderThickness="0" Height="45" FontSize="14" HorizontalContentAlignment="Left" Padding="12,0" Margin="0,8,0,0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="0,0,10,10" />
    </Grid>
</Window>