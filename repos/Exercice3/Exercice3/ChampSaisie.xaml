<UserControl x:Class="Exercice3.ChampSaisie"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Exercice3"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Titre, ElementName=Root}" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,5" />

        <TextBox Text="{Binding TexteSaisi, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" 
                 Padding="5" />
    </StackPanel>
</UserControl>
