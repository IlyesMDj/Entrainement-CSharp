<Window x:Class="Exercice3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Exercice3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <DataTemplate DataType="{x:Type local:ClientsViewModel}">
            <local:ClientsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ProduitsViewModel}">
            <local:ProduitsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50" Padding="10">
            <StackPanel Grid.Column="0" Background="#2C3E50">
            <TextBlock Text="NAVIGATION" Foreground="White" FontWeight="Bold" Margin="0,10,0,20"/>

            <Button Content="Clients" Command="{Binding AfficherPageClientsCommand}" Margin="0,5" Padding="10" Background="#34495E" Foreground="White" BorderThickness="0"/>
            <Button Content="📦 Produits" Command="{Binding AfficherPageProduitsCommand}" Margin="0,5" Padding="10" Background="#34495E" Foreground="White" BorderThickness="0"/>
        </StackPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding VueCourante}" />

        <StatusBar VerticalAlignment="Bottom" Background="WhiteSmoke" Margin="0,5 " Padding="2" BorderThickness="0">
            <TextBlock Text="{Binding NotificationGlobale}" FontWeight="Bold" Foreground="DarkBlue" Margin="0,5"/>
        </StatusBar>
    </Grid>
</Window>
